{
  "name": "temporal-workflow-builder",
  "private": true,
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "db:generate": "npm run db:generate -w web",
    "db:migrate": "npm run db:migrate -w web",
    "test": "npm test -w shared && npm test -w worker",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w worker && npm run typecheck -w web"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.13"
  }
}
